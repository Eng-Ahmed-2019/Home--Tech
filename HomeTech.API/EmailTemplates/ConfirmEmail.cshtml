@model HomeTech.Application.DTOs.Emails.ConfirmEmailModel

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
            padding: 20px;
        }
        .card {
            background: #ffffff;
            padding: 30px;
            border-radius: 10px;
            max-width: 600px;
            margin: auto;
        }
        .btn {
            display: inline-block;
            background: #2563eb;
            color: #ffffff !important;
            padding: 12px 20px;
            border-radius: 6px;
            text-decoration: none;
            margin-top: 20px;
        }
        .footer {
            margin-top: 30px;
            font-size: 12px;
            color: #777;
        }
    </style>
</head>
<body>
    <div class="card">
        <h2>مرحبًا @Model.FullName 👋</h2>

        <p>
            شكرًا لانضمامك إلى <strong>HomeTech</strong>.
            من فضلك قم بتأكيد بريدك الإلكتروني لإكمال التسجيل.
        </p>

        <a class="btn" href="@Model.ConfirmLink">
            تأكيد البريد الإلكتروني
        </a>

        <div class="footer">
            <p>
                إذا لم تقم بإنشاء هذا الحساب، يمكنك تجاهل الرسالة.
            </p>
            <p>
                © HomeTech
            </p>
        </div>
    </div>
</body>
</html>